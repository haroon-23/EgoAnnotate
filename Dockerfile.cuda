FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 python3.10-venv python3-pip ffmpeg git libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md LICENSE LICENSES.md THIRD_PARTY_NOTICES.md ./
COPY configs ./configs
COPY src/egoannotate ./src/egoannotate
COPY scripts/download_models.py ./scripts/download_models.py

RUN python3.10 -m pip install --upgrade pip && \
    python3.10 -m pip install --index-url https://download.pytorch.org/whl/cu124 torch torchvision && \
    python3.10 -m pip install ".[gpu]"

ENTRYPOINT ["egoannotate"]
CMD ["worker", "--host", "0.0.0.0", "--port", "8080"]
