# EgoAnnotate v1.0 Environment Configuration
# Copy this file to .env and fill in your Gemini API key:
#   cp .env.example .env

GEMINI_API_KEY=your_gemini_api_key_here

# Optional pacing override (seconds between Gemini calls; default 4.0s for free tier ~15 RPM)
GEMINI_MIN_INTERVAL_S=4.0
GEMINI_MAX_ATTEMPTS=5
